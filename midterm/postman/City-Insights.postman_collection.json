          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "places"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Medeu\",\n  \"city\": \"Almaty\",\n  \"category\": \"sport\",\n  \"description\": \"High-altitude skating rink\",\n  \"address\": \"Gornaya St\",\n  \"rating\": 4.7\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('placeId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
