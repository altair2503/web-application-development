    {
      "name": "List places by city",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/places?city=Almaty",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "places"
          ],
          "query": [
            {
              "key": "city",
              "value": "Almaty"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('only Almaty', () => pm.response.json().forEach(p => pm.expect(p.city).to.eql('Almaty')));"
            ]
          }
        }
      ]
    },
