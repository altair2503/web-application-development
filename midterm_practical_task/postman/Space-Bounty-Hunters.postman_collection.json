                ]
              }
            }
          ]
        },
        {
          "name": "List hunt logs by criminal_id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/?criminal_id=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts"
              ],
              "query": [
                {
                  "key": "criminal_id",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('only criminal 1', () => pm.response.json().forEach(h => pm.expect(h.criminal_id).to.eql(1)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create hunt log",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const h = pm.response.json();",
                  "pm.collectionVariables.set('huntId', h.id);",
                  "pm.test('server set created_at', () => pm.expect(h.created_at).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get hunt log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('matches created', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('huntId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update hunt log (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"notes\": \"Caught him on the second try.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('updated', () => { const h = pm.response.json(); pm.expect(h.success).to.be.true; pm.expect(h.notes).to.eql('Caught him on the second try.'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete hunt log",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
