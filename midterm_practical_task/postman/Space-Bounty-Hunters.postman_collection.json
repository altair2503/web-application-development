{
  "info": {
    "name": "Space Bounty Hunters",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Criminals",
      "item": [
        {
          "name": "List criminals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has >= 5', () => pm.expect(pm.response.json().length).to.be.at.least(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter + sort: min_reward=5000, armed=true, sort=-reward",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const l = pm.response.json();",
                  "pm.test('all armed and reward >= 5000', () => l.forEach(c => pm.expect(c.armed && c.reward >= 5000).to.be.true));",
                  "pm.test('sorted by reward desc', () => { for (let i=1;i<l.length;i++) pm.expect(l[i-1].reward).to.be.at.least(l[i].reward); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: reward range + has_crew + escape_master",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?min_reward=1000000&max_reward=10000000&has_crew=true&escape_master=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "1000000"
                },
                {
                  "key": "max_reward",
                  "value": "10000000"
                },
                {
                  "key": "has_crew",
                  "value": "true"
                },
                {
                  "key": "escape_master",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('filters combined', () => pm.response.json().forEach(c => pm.expect(c.has_crew && c.escape_master && c.reward>=1000000 && c.reward<=10000000).to.be.true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sort by reward ascending",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?sort=reward",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "reward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const l = pm.response.json();",
                  "pm.test('sorted asc', () => { for (let i=1;i<l.length;i++) pm.expect(l[i-1].reward).to.be.at.most(l[i].reward); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Criminal details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/3/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                "3"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('id is 3', () => pm.expect(pm.response.json().id).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Criminal not found (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/9999/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                "9999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
